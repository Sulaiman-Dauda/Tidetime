# ── Bootstrap (required in production) ──────────────────────────────────────────
# SMTP and Stripe are configured via the Settings UI and stored encrypted in
# the database. Google Calendar OAuth client credentials stay in the app env.

# Environment
NODE_ENV=production

# App — the public URL where Tidetime is accessible
APP_URL=https://tidetime.example.com
APP_NAME=Tidetime

# Database (PostgreSQL only)
DATABASE_URL=postgres://user:password@host:5432/tidetime

# Auth — 32+ byte random secret for session encryption. Generate: openssl rand -base64 32
AUTH_SECRET=

# Google Calendar OAuth (optional — for calendar sync)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe keys are configured in Settings → Payments after bootstrap.
# No Stripe .env variables are required for normal operation.
