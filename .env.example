# ── Bootstrap (required in production) ──────────────────────────────────────────
# Everything else (SMTP, Stripe, etc.) is configured via the Settings UI
# and stored encrypted in the database. No ambiguity — DB always wins.

# Environment
NODE_ENV=production

# App — the public URL where Tidetime is accessible
APP_URL=https://tidetime.example.com
APP_NAME=Tidetime

# Database (PostgreSQL only)
DATABASE_URL=postgres://user:password@host:5432/tidetime

# Auth — 32+ byte random secret for session encryption. Generate: openssl rand -base64 32
AUTH_SECRET=
