NODE_ENV=production

# Required in production.
APP_URL=https://book.example.com
APP_NAME=Your Company
DATABASE_URL=postgres://user:password@host:5432/tidetime_lite
# Required by docker-compose.prod.yml for its private PostgreSQL container.
# Use a URL-safe random value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Protects POST /api/cron when an external scheduler invokes it.
# Generate a separate value with: openssl rand -base64 32
CRON_SECRET=

# Optional: provider calendar conflict checks and Google Meet links.
# OAuth callback: <APP_URL>/api/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP is configured by an administrator in Dashboard → Connections.
# Zapier receives signed outgoing webhooks configured on the same page.

# --- Optional compose / worker tunables (defaults shown) -------------------
# How often the background jobs worker ticks, in seconds (min 30).
#JOBS_INTERVAL_SECONDS=300
# Where the jobs worker posts its tick. Default targets the compose network;
# set this when running `npm run jobs:worker` outside Docker.
#JOBS_TARGET_URL=http://app:3100/api/cron
# docker-compose.prod.yml port/image overrides.
#APP_PORT=3000
#HTTP_PORT=80
#HTTPS_PORT=443
#TIDETIME_IMAGE=tide-time-lite:local
#POSTGRES_USER=postgres
#POSTGRES_DB=tidetime
# Dev compose (docker-compose.yml) host port for PostgreSQL.
#POSTGRES_PORT=5432
