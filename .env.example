# ──────────────────────────────────────────────────────────────────────────────
# Tidetime environment
#
# Philosophy: .env holds only BOOTSTRAP config (what's needed to start the app).
# Everything else — SMTP, Stripe, and all integration credentials (Google,
# Microsoft, Zoom, Daily, HubSpot) — is configured in the app at
# Settings → Integrations and stored encrypted in the database.
#
# So the integration variables below are OPTIONAL fallbacks: set them here if you
# prefer managing secrets via env, or leave them blank and paste the values into
# the UI after first launch. The UI always wins when both are present.
# ──────────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED (production) ══════════════════════════════════════════════════════

NODE_ENV=production

# The public URL where Tidetime is served. Used for OAuth redirect URIs, links
# in emails, and the booking pages. No trailing slash.
APP_URL=https://tidetime.example.com

# PostgreSQL connection string (PostgreSQL only).
DATABASE_URL=postgres://user:password@host:5432/tidetime

# Session/encryption secret — also the key for encrypting integration secrets at
# rest. Must be 32+ characters in production. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=


# ═══ RECOMMENDED ════════════════════════════════════════════════════════════════

# Display name used across the UI and emails (defaults to "Tidetime").
APP_NAME=Tidetime

# Shared secret for the background job runner (reminders, webhooks, retention).
# Required if you trigger jobs via the HTTP endpoint (POST /api/cron) from an
# external scheduler (Vercel Cron, Cloud Scheduler, GitHub Actions, …). Not
# needed if you run the long-running worker (npm run jobs:worker).
#   openssl rand -base64 32
CRON_SECRET=


# ═══ OPTIONAL — integrations (or set these in Settings → Integrations) ══════════
#
# Each provider also needs an OAuth app registered on the provider's side, with
# this redirect URI allowed:
#   Google     <APP_URL>/api/google-calendar/callback
#   Microsoft  <APP_URL>/api/microsoft-calendar/callback
#   Zoom       <APP_URL>/api/apps/zoom_video/callback
#   HubSpot    <APP_URL>/api/apps/hubspot/callback
# (Daily uses a single account API key — no OAuth app or redirect URI.)
# (Apple/CalDAV needs nothing here — users enter their server URL + app password.)

# Google Calendar (calendar sync + Google Meet links)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft 365 / Outlook (calendar sync + Teams meeting links)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Zoom (auto-generate a Zoom meeting per booking)
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# Daily (auto-create a video room per booking — account-level API key)
# DAILY_API_KEY=
# DAILY_SUBDOMAIN=

# HubSpot (log each booking as a contact + meeting)
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Stripe is configured entirely in Settings → Payments (publishable key, secret
# key, webhook secret). No Stripe .env variables are required.


# ═══ OPTIONAL — advanced ════════════════════════════════════════════════════════

# Self-hosted licensing (leave blank for the open-source Community edition).
# LICENSE_KEY=
# LICENSE_PUBLIC_KEY=

# AI features (optional).
# OPENAI_API_KEY=
