# Environment
NODE_ENV=development

# App
APP_URL=http://localhost:3000
APP_NAME=Tidetime
NEXT_TELEMETRY_DISABLED=1

# Database (PostgreSQL only)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tidetime

# Auth — 32+ byte random secret used to sign/encrypt. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-please-32b

# SMTP (optional — emails are logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tidetime <no-reply@tidetime.app>"

# Stripe (optional, but both values must be set together)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
