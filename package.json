{
  "name": "tide-time-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight company service booking with provider assignment and Zapier webhooks.",
  "license": "MIT",
  "homepage": "https://github.com/Sulaiman-Dauda/tidetime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sulaiman-Dauda/tidetime.git"
  },
  "bugs": {
    "url": "https://github.com/Sulaiman-Dauda/tidetime/issues"
  },
  "keywords": [
    "scheduling",
    "calendar",
    "booking",
    "appointments",
    "appointment-scheduling",
    "team-scheduling",
    "nextjs",
    "typescript",
    "self-hosted",
    "open-source"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.7",
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:runtime": "node scripts/migrate-runtime.mjs",
    "db:reset": "node --env-file=.env scripts/reset-dev-db.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "jobs:worker": "node scripts/jobs-worker.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.21",
    "@radix-ui/react-avatar": "^1.2.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-toast": "^1.2.21",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@react-email/render": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "intl-messageformat": "^11.2.12",
    "lucide-react": "^0.469.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
